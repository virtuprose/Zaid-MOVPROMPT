{
  "name": "movprompt",
  "private": true,
  "version": "0.0.0",
  "description": "MovPrompt template-first and advanced AI video creation platform",
  "type": "module",
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": "24.x",
    "bun": ">=1.3.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:api": "bun --cwd apps/api run dev",
    "dev:worker": "bun --cwd apps/worker run dev",
    "dev:services": "docker compose up -d postgres minio minio-init mailpit",
    "dev:stack": "docker compose up --build",
    "build": "vite build",
    "build:web": "vite build",
    "build:workspaces": "bun run --filter '@movprompt/*' build",
    "build:all": "bun run build:web && bun run build:workspaces",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--localstorage-file=/tmp/movprompt-vitest-localstorage vitest run",
    "test:watch": "NODE_OPTIONS=--localstorage-file=/tmp/movprompt-vitest-localstorage vitest",
    "test:workspaces": "bun run --filter '@movprompt/*' test",
    "test:all": "bun run test && bun run test:workspaces",
    "typecheck:web": "tsc -b --pretty false",
    "typecheck:workspaces": "bun run --filter '@movprompt/*' typecheck",
    "typecheck": "bun run typecheck:web && bun run typecheck:workspaces",
    "db:generate": "bun --cwd packages/db run generate",
    "db:migrate": "bun --cwd packages/db run migrate",
    "db:check": "bun --cwd packages/db run check",
    "db:studio": "bun --cwd packages/db run studio"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@lovable.dev/cloud-auth-js": "^1.1.1",
    "@lovable.dev/mcp-js": "^0.20.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@supabase/supabase-js": "^2.103.0",
    "@tanstack/react-query": "^5.83.0",
    "@testing-library/dom": "^10.4.0",
    "ai": "^6.0.182",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.12.0",
    "motion": "^12.38.0",
    "nanoid": "^5.1.11",
    "next-themes": "^0.3.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.61.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "use-stick-to-bottom": "^1.1.4",
    "vaul": "^0.9.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "lovable-tagger": "^1.1.13",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19",
    "vitest": "^3.2.4"
  }
}
