COMPOSE_PROJECT_NAME=movprompt-local

APP_ENV=local
PUBLIC_APP_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:8080
API_ORIGIN=http://localhost:8787
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
VITE_API_ORIGIN=http://localhost:8787
# Requires `docker compose --profile application up`; use false for a web-only session.
VITE_FEATURE_PORTABLE_AUTH=true
FEATURE_AUTHENTICATION=true
FEATURE_ASSETS=true
FEATURE_TEMPLATE_MODE=true
FEATURE_ADVANCED_MODE=true
FEATURE_GENERATION=false
GENERATION_PRICING_VERSION=
GENERATION_QUOTE_TTL_SECONDS=
GENERATION_SEEDANCE_CREDITS_PER_SECOND=
GENERATION_OMNI_FLASH_CREDITS_PER_SECOND=
GENERATION_NANO_BANANA_CREDITS_PER_IMAGE=
FEATURE_EXPORTS=false
FEATURE_BILLING=false

POSTGRES_DB=movprompt
POSTGRES_USER=movprompt
POSTGRES_PASSWORD=movprompt-local-only
POSTGRES_PORT=5432
DATABASE_URL_POOLED=postgresql://movprompt:movprompt-local-only@localhost:5432/movprompt
DATABASE_URL_DIRECT=postgresql://movprompt:movprompt-local-only@localhost:5432/movprompt
DATABASE_SSL=false

MINIO_ROOT_USER=movprompt-local
MINIO_ROOT_PASSWORD=movprompt-local-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=movprompt-local
S3_SECRET_ACCESS_KEY=movprompt-local-secret
S3_FORCE_PATH_STYLE=true
S3_ASSETS_BUCKET=creator-assets
S3_OUTPUTS_BUCKET=creator-outputs
S3_PREVIEWS_BUCKET=template-previews
S3_UPLOAD_URL_TTL_SECONDS=900
S3_DOWNLOAD_URL_TTL_SECONDS=900
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_MAX_MESSAGES=500
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=MovPrompt <no-reply@localhost>

BETTER_AUTH_URL=http://localhost:8787
BETTER_AUTH_SECRET=movprompt-local-only-better-auth-secret-change-me
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

WORKER_ID=movprompt-local-worker
WORKER_SMOKE_TEST_ON_START=true
WORKER_OUTBOX_BATCH_SIZE=20
WORKER_OUTBOX_LEASE_MS=60000
WORKER_OUTBOX_POLL_INTERVAL_MS=1000
WORKER_RENDER_RECONCILIATION_DELAY_SECONDS=15

MOVPROMPT_CAPABILITY_SEEDANCE_ENABLED=false
MOVPROMPT_CAPABILITY_SEEDANCE_ADAPTER_ID=
MOVPROMPT_CAPABILITY_SEEDANCE_MODEL_ID=
MOVPROMPT_CAPABILITY_OMNI_FLASH_ENABLED=false
MOVPROMPT_CAPABILITY_OMNI_FLASH_ADAPTER_ID=
MOVPROMPT_CAPABILITY_OMNI_FLASH_MODEL_ID=
MOVPROMPT_CAPABILITY_NANO_BANANA_ENABLED=false
MOVPROMPT_CAPABILITY_NANO_BANANA_ADAPTER_ID=
MOVPROMPT_CAPABILITY_NANO_BANANA_MODEL_ID=

API_PORT=8787
