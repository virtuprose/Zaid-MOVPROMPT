MOVPROMPT_GATEWAY_CONFIRM_PAID_VIDEO=NO
MOVPROMPT_GATEWAY_VIDEO_DURATION_SECONDS=4
MOVPROMPT_GATEWAY_VIDEO_ASPECT_RATIO=9:16
MOVPROMPT_GATEWAY_VIDEO_RESOLUTION_TIER=720p
