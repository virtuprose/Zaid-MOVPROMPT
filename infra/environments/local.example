COMPOSE_PROJECT_NAME=movprompt-local

APP_ENV=local
PUBLIC_APP_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:8080
API_ORIGIN=http://localhost:8787
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
VITE_API_ORIGIN=http://localhost:8787
# Requires `docker compose --profile application up`; use false for a web-only session.
VITE_FEATURE_PORTABLE_AUTH=true
VITE_AUTH_REQUIRE_EMAIL_VERIFICATION=false
VITE_AUTH_GOOGLE_ENABLED=false
VITE_AUTH_APPLE_ENABLED=false
VITE_FEATURE_GUEST_CREATOR=true
VITE_FEATURE_WORKSPACE_SHELL=true
VITE_FEATURE_PROJECTS=true
VITE_FEATURE_ADVANCED_MODE=true
VITE_FEATURE_EXPORT_PIPELINE=false
# Optional client-demo simulation. It never calls an AI provider or charges credits.
VITE_FEATURE_LOCAL_DEMO_GENERATION=false
FEATURE_AUTHENTICATION=true
FEATURE_ASSETS=true
FEATURE_TEMPLATE_MODE=true
FEATURE_ADVANCED_MODE=true
FEATURE_GENERATION=false
GENERATION_PRICING_VERSION=
GENERATION_QUOTE_TTL_SECONDS=
GENERATION_STARTER_ONLY=true
GENERATION_VIDEO_CINEMATIC_480P_CREDITS_PER_SECOND=
GENERATION_VIDEO_CINEMATIC_720P_CREDITS_PER_SECOND=
GENERATION_VIDEO_PRODUCT_FIDELITY_480P_CREDITS_PER_SECOND=
GENERATION_VIDEO_PRODUCT_FIDELITY_720P_CREDITS_PER_SECOND=
GENERATION_VIDEO_FIXED_RESOLUTION=
GENERATION_VIDEO_CINEMATIC_CREDITS_PER_SECOND=
GENERATION_VIDEO_PRODUCT_FIDELITY_CREDITS_PER_SECOND=
GENERATION_IMAGE_PRODUCT_CREDITS_PER_IMAGE=
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_HEARTBEAT_MAX_AGE_SECONDS=45
FEATURE_EXPORTS=false
FEATURE_BILLING=false

POSTGRES_DB=movprompt
POSTGRES_USER=movprompt
POSTGRES_PASSWORD=movprompt-local-only
POSTGRES_PORT=5432
DATABASE_URL_POOLED=postgresql://movprompt:movprompt-local-only@localhost:5432/movprompt
DATABASE_URL_DIRECT=postgresql://movprompt:movprompt-local-only@localhost:5432/movprompt
DATABASE_SSL=false

MINIO_ROOT_USER=movprompt-local
MINIO_ROOT_PASSWORD=movprompt-local-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=movprompt-local
S3_SECRET_ACCESS_KEY=movprompt-local-secret
S3_FORCE_PATH_STYLE=true
S3_ASSETS_BUCKET=creator-assets
S3_OUTPUTS_BUCKET=creator-outputs
# Exact output host or leading-dot DNS suffix; never guess from documentation.
PROVIDER_OUTPUT_ALLOWED_HOSTS=ark-acg-ap-southeast-1.tos-ap-southeast-1.volces.com
AI_GATEWAY_API_KEY=
VERCEL_AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v4/ai
VERCEL_GATEWAY_SEEDANCE_RESOLUTION_TIER=720p
VERCEL_GATEWAY_SEEDANCE_GENERATE_AUDIO=false
