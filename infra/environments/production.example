# Documentation contract only. Supply real values from the production secret
# store; do not commit a populated copy.
APP_ENV=production
PUBLIC_APP_URL=https://example.invalid
WEB_ORIGIN=https://example.invalid
API_ORIGIN=https://api.example.invalid
CORS_ALLOWED_ORIGINS=https://example.invalid
VITE_API_ORIGIN=https://api.example.invalid
VITE_FEATURE_PORTABLE_AUTH=true
FEATURE_AUTHENTICATION=true
FEATURE_ASSETS=true
FEATURE_TEMPLATE_MODE=true
FEATURE_ADVANCED_MODE=true
FEATURE_GENERATION=false
GENERATION_PRICING_VERSION=
GENERATION_QUOTE_TTL_SECONDS=
GENERATION_SEEDANCE_CREDITS_PER_SECOND=
GENERATION_OMNI_FLASH_CREDITS_PER_SECOND=
GENERATION_NANO_BANANA_CREDITS_PER_IMAGE=
FEATURE_EXPORTS=false
FEATURE_BILLING=false
DATABASE_URL_POOLED=postgresql://REQUIRED_POOLED_URL_FROM_SECRET_STORE
DATABASE_URL_DIRECT=postgresql://REQUIRED_DIRECT_URL_FROM_SECRET_STORE
DATABASE_SSL=require
S3_ENDPOINT=https://REQUIRED_PRODUCTION_OBJECT_STORE
S3_REGION=REQUIRED_PRODUCTION_REGION
S3_ACCESS_KEY_ID=REQUIRED_FROM_SECRET_STORE
S3_SECRET_ACCESS_KEY=REQUIRED_FROM_SECRET_STORE
S3_FORCE_PATH_STYLE=false
S3_ASSETS_BUCKET=creator-assets
S3_OUTPUTS_BUCKET=creator-outputs
S3_PREVIEWS_BUCKET=template-previews
S3_UPLOAD_URL_TTL_SECONDS=900
S3_DOWNLOAD_URL_TTL_SECONDS=900
SMTP_HOST=REQUIRED_PRODUCTION_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=REQUIRED_FROM_SECRET_STORE
SMTP_PASSWORD=REQUIRED_FROM_SECRET_STORE
EMAIL_FROM=MovPrompt <no-reply@example.invalid>
BETTER_AUTH_URL=https://api.example.invalid
BETTER_AUTH_SECRET=REQUIRED_FROM_SECRET_STORE
BETTER_AUTH_TRUSTED_ORIGINS=https://example.invalid
GOOGLE_CLIENT_ID=REQUIRED_FROM_PRODUCTION_OAUTH_APP
GOOGLE_CLIENT_SECRET=REQUIRED_FROM_SECRET_STORE
APPLE_CLIENT_ID=REQUIRED_FROM_PRODUCTION_OAUTH_APP
APPLE_CLIENT_SECRET=REQUIRED_FROM_SECRET_STORE
APPLE_APP_BUNDLE_IDENTIFIER=REQUIRED_PRODUCTION_BUNDLE_IDENTIFIER
WORKER_ID=movprompt-production-worker
WORKER_SMOKE_TEST_ON_START=false
WORKER_OUTBOX_BATCH_SIZE=20
WORKER_OUTBOX_LEASE_MS=60000
WORKER_OUTBOX_POLL_INTERVAL_MS=1000
WORKER_RENDER_RECONCILIATION_DELAY_SECONDS=15
