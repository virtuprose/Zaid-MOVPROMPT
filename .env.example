# Runtime
NODE_ENV=development
APP_ENV=local
PUBLIC_APP_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:8080
API_ORIGIN=http://localhost:8787
API_PORT=8787
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Feature flags are server-controlled. Public Vite values only select local UI visibility.
FEATURE_TEMPLATE_MODE=true
FEATURE_ADVANCED_MODE=true
FEATURE_AUTHENTICATION=true
FEATURE_ASSETS=true
FEATURE_GENERATION=false
FEATURE_EXPORTS=false
FEATURE_BILLING=false
VITE_API_ORIGIN=http://localhost:8787
# Enable only while the portable API is running (for Compose, use --profile application).
VITE_FEATURE_PORTABLE_AUTH=true
VITE_FEATURE_GUEST_CREATOR=true
VITE_FEATURE_WORKSPACE_SHELL=true
VITE_FEATURE_PROJECTS=true
VITE_FEATURE_ADVANCED_MODE=true
VITE_FEATURE_EXPORT_PIPELINE=false

# PostgreSQL: pooled for API traffic; direct for migrations, workers and pg-boss.
DATABASE_URL_POOLED=postgresql://movprompt:movprompt@localhost:5432/movprompt
DATABASE_URL_DIRECT=postgresql://movprompt:movprompt@localhost:5432/movprompt
DATABASE_SSL=false

# Better Auth
BETTER_AUTH_URL=http://localhost:8787
# Known local-only value. Generate a unique secret for every shared environment.
BETTER_AUTH_SECRET=movprompt-local-only-better-auth-secret-change-me
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
EMAIL_FROM=MovPrompt <no-reply@localhost>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# S3-compatible private object storage (MinIO locally, Cloudflare R2 in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=movprompt-local
S3_SECRET_ACCESS_KEY=movprompt-local-secret
S3_FORCE_PATH_STYLE=true
S3_ASSETS_BUCKET=creator-assets
S3_OUTPUTS_BUCKET=creator-outputs
S3_PREVIEWS_BUCKET=template-previews
S3_UPLOAD_URL_TTL_SECONDS=900
S3_DOWNLOAD_URL_TTL_SECONDS=900

# Durable PostgreSQL outbox and reconciliation worker
WORKER_ID=movprompt-local-worker
WORKER_SMOKE_TEST_ON_START=true
WORKER_OUTBOX_BATCH_SIZE=20
WORKER_OUTBOX_LEASE_MS=60000
WORKER_OUTBOX_POLL_INTERVAL_MS=1000
WORKER_RENDER_RECONCILIATION_DELAY_SECONDS=15

# Approved capability providers. Raw provider IDs stay server-side.
SEEDANCE_API_BASE_URL=
SEEDANCE_API_KEY=
SEEDANCE_MODEL_ID=
MOVPROMPT_CAPABILITY_SEEDANCE_ENABLED=false
MOVPROMPT_CAPABILITY_SEEDANCE_ADAPTER_ID=
MOVPROMPT_CAPABILITY_SEEDANCE_MODEL_ID=
OMNI_FLASH_API_BASE_URL=
OMNI_FLASH_API_KEY=
OMNI_FLASH_MODEL_ID=
MOVPROMPT_CAPABILITY_OMNI_FLASH_ENABLED=false
MOVPROMPT_CAPABILITY_OMNI_FLASH_ADAPTER_ID=
MOVPROMPT_CAPABILITY_OMNI_FLASH_MODEL_ID=
NANO_BANANA_API_BASE_URL=
NANO_BANANA_API_KEY=
NANO_BANANA_MODEL_ID=
MOVPROMPT_CAPABILITY_NANO_BANANA_ENABLED=false
MOVPROMPT_CAPABILITY_NANO_BANANA_ADAPTER_ID=
MOVPROMPT_CAPABILITY_NANO_BANANA_MODEL_ID=
PROVIDER_WEBHOOK_SECRET=

# Authoritative credit pricing. Leave blank to keep generation fail-closed.
# Values must be set only after the live provider bake-off and commercial approval.
GENERATION_PRICING_VERSION=
GENERATION_QUOTE_TTL_SECONDS=
GENERATION_SEEDANCE_CREDITS_PER_SECOND=
GENERATION_OMNI_FLASH_CREDITS_PER_SECOND=
GENERATION_NANO_BANANA_CREDITS_PER_IMAGE=

# UPayments hosted checkout (KWD credit bundles)
UPAYMENTS_API_BASE_URL=https://sandboxapi.upayments.com
UPAYMENTS_API_KEY=
UPAYMENTS_MERCHANT_ID=
UPAYMENTS_WEBHOOK_SECRET=
UPAYMENTS_SUCCESS_URL=http://localhost:8080/billing/success
UPAYMENTS_CANCEL_URL=http://localhost:8080/billing/cancel

# Legacy Supabase is read-only during migration and must not be used by the new runtime.
LEGACY_SUPABASE_URL=
LEGACY_SUPABASE_SERVICE_ROLE_KEY=
LEGACY_SUPABASE_STORAGE_BUCKETS=

# Existing frontend compatibility only; remove at final cutover.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
