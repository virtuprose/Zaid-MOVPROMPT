# Runtime
NODE_ENV=development
APP_ENV=local
WEB_ORIGIN=http://localhost:8080
API_ORIGIN=http://localhost:8787
PORT=8787
LOG_LEVEL=debug

# Feature flags are server-controlled. Public Vite values only select local UI visibility.
FEATURE_TEMPLATE_MODE=true
FEATURE_ADVANCED_MODE=true
FEATURE_GENERATION=false
FEATURE_EXPORTS=false
FEATURE_BILLING=false
VITE_API_ORIGIN=http://localhost:8787
VITE_FEATURE_GUEST_CREATOR=true
VITE_FEATURE_WORKSPACE_SHELL=true
VITE_FEATURE_PROJECTS=true
VITE_FEATURE_ADVANCED_MODE=true
VITE_FEATURE_EXPORT_PIPELINE=false

# PostgreSQL: pooled for API traffic; direct for migrations, workers and pg-boss.
DATABASE_URL_POOLED=postgresql://movprompt:movprompt@localhost:5432/movprompt
DATABASE_URL_DIRECT=postgresql://movprompt:movprompt@localhost:5432/movprompt
DATABASE_SSL=false

# Better Auth
BETTER_AUTH_URL=http://localhost:8787
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
EMAIL_FROM=MovPrompt <no-reply@localhost>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# S3-compatible private object storage (MinIO locally, Cloudflare R2 in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=movprompt
S3_SECRET_ACCESS_KEY=movprompt-local-secret
S3_FORCE_PATH_STYLE=true
S3_ASSETS_BUCKET=creator-assets
S3_OUTPUTS_BUCKET=creator-outputs
S3_SIGNED_URL_TTL_SECONDS=900

# Approved capability providers. Raw provider IDs stay server-side.
SEEDANCE_API_BASE_URL=
SEEDANCE_API_KEY=
SEEDANCE_MODEL_ID=
OMNI_FLASH_API_BASE_URL=
OMNI_FLASH_API_KEY=
OMNI_FLASH_MODEL_ID=
NANO_BANANA_API_BASE_URL=
NANO_BANANA_API_KEY=
NANO_BANANA_MODEL_ID=
PROVIDER_WEBHOOK_SECRET=

# UPayments hosted checkout (KWD credit bundles)
UPAYMENTS_API_BASE_URL=https://sandboxapi.upayments.com
UPAYMENTS_API_KEY=
UPAYMENTS_MERCHANT_ID=
UPAYMENTS_WEBHOOK_SECRET=
UPAYMENTS_SUCCESS_URL=http://localhost:8080/billing/success
UPAYMENTS_CANCEL_URL=http://localhost:8080/billing/cancel

# Legacy Supabase is read-only during migration and must not be used by the new runtime.
LEGACY_SUPABASE_URL=
LEGACY_SUPABASE_SERVICE_ROLE_KEY=
LEGACY_SUPABASE_STORAGE_BUCKETS=

# Existing frontend compatibility only; remove at final cutover.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
